---
import { SITE } from '../data/site';

const nav = [
  { label: 'Guides', href: '/guides/' },
  { label: 'Compare', href: '/compare/' },
  { label: 'Get shortlist', href: '/get-shortlist/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];
---
<header class="sticky top-0 z-50 border-b border-[#e2ddd3] bg-[rgba(248,246,241,0.92)] backdrop-blur-md">
  <div class="site-container flex items-center justify-between gap-4 py-4">
    <a href="/" class="flex items-center gap-2 no-underline">
      <img src="/favicon.svg" alt="" width="32" height="32" class="rounded-md" />
      <span class="font-serif text-lg font-semibold text-[var(--color-navy-900)]">{SITE.name}</span>
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      {nav.map((item) => (
        <a href={item.href} class="text-[var(--color-slate-700)] hover:text-[var(--color-navy-900)]">{item.label}</a>
      ))}
    </nav>
    <a href="/get-shortlist/" class="btn-primary text-sm px-4 py-2 shrink-0">Free shortlist</a>
  </div>
</header>
