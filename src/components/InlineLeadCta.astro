---
/**
 * Compact lead capture placed inside the article body.
 *
 * `leadPlacement` already allows a form before the prose, but only 6 of ~610
 * pages set it, so in practice the single LeadForm sits after the article, the
 * FAQ and the money strip: measured at 86 % of page depth on a 375 px screen.
 * GA4's 90 % scroll event says under 10 % of sessions reach that.
 *
 * Rendered after the prose and relocated by the inline script below to sit
 * between the first and second H2. Phone and market only: the desk keys its
 * follow-up on the phone number, so this asks for the same contact field the
 * full form does rather than inventing a second shape of lead.
 */
interface Props {
  context?: string;
}

const { context = '' } = Astro.props;
---
<div class="inline-cta" data-inline-cta>
  <form class="inline-cta__form ig-inline-form" id="ig-inline-lead-form" data-context={context} novalidate>
    <p class="inline-cta__lead">
      <strong>Want this priced for your budget?</strong>
      Tell us the market and how to reach you. Independent research first, then 3 to 5 matched options with the numbers behind each one.
    </p>

    <div class="inline-cta__row">
      <div class="inline-cta__field">
        <label class="inline-cta__label" for="il-market">Target market</label>
        <select id="il-market" name="market">
          <option value="">Select</option>
          <option value="dubai">Dubai</option>
          <option value="abu-dhabi">Abu Dhabi</option>
          <option value="rak">Ras Al Khaimah</option>
          <option value="qatar">Qatar</option>
          <option value="saudi">Saudi Arabia</option>
          <option value="oman">Oman / Bahrain</option>
          <option value="multi">Multiple / not sure</option>
        </select>
      </div>
      <div class="inline-cta__field">
        <label class="inline-cta__label" for="il-phone">WhatsApp / Phone</label>
        <input type="tel" id="il-phone" name="phone" placeholder="+44 7700 900000" autocomplete="tel" />
      </div>
      <button type="submit" class="btn-primary inline-cta__btn">Request shortlist →</button>
    </div>

    <p id="il-error" class="inline-cta__error hidden" role="alert"></p>

    <div class="lead-form-consent inline-cta__consent">
      <input type="checkbox" id="il-consent" name="consent" class="lead-form-consent__check" />
      <label class="lead-form-consent__label" for="il-consent">I agree to be contacted about my enquiry. See our <a href="/privacy-policy/">Privacy Policy</a>.</label>
    </div>

    <p id="il-success" class="inline-cta__success hidden">Thank you. Redirecting…</p>
  </form>
</div>

<script is:inline>
  /*
   * Runs during parsing, immediately after the prose has been read, so the band
   * is in its final position before first paint. Without JS it stays where it
   * is; the form needs fetch to submit either way.
   */
  (function relocateInlineCta() {
    var band = document.querySelector('[data-inline-cta]');
    var prose = document.querySelector('.prose');
    if (!band || !prose) return;
    var headings = prose.querySelectorAll(':scope > h2');
    if (headings.length < 3) return;
    var anchor = headings[1];
    var separator = anchor.previousElementSibling;
    prose.insertBefore(band, separator && separator.tagName === 'HR' ? separator : anchor);
  })();
</script>

<script>
  import { track } from '../lib/track';

  const form = document.getElementById('ig-inline-lead-form') as HTMLFormElement | null;
  if (form) {
    const renderedAt = Date.now();
    const errorEl = document.getElementById('il-error');
    let started = false;

    function pageIdentity() {
      const parts = window.location.pathname.split('/').filter(Boolean);
      return {
        collection: parts.length > 1 ? parts[0] : 'root',
        slug: parts.length > 0 ? parts[parts.length - 1] : 'home',
      };
    }

    form.querySelectorAll('input:not([tabindex="-1"]), select, textarea').forEach((field) => {
      field.addEventListener(
        'focus',
        () => {
          if (started) return;
          started = true;
          const { collection, slug } = pageIdentity();
          track('form_start', {
            form_id: form!.id,
            form_context: form!.dataset.context || '',
            form_location: 'inline',
            page_path: window.location.pathname,
            collection,
            slug,
          });
        },
        { once: true },
      );
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const phone = String(data.get('phone') || '').trim();
      const { collection, slug } = pageIdentity();

      function reportInvalid(reason: string, message: string, focusId: string) {
        if (errorEl) {
          errorEl.textContent = message;
          errorEl.classList.remove('hidden');
        }
        (document.getElementById(focusId) as HTMLElement | null)?.focus();
        track('form_validation_error', {
          form_id: form!.id,
          form_location: 'inline',
          reason,
          page_path: window.location.pathname,
          collection,
          slug,
        });
      }

      if (phone.replace(/\D/g, '').length < 8) {
        reportInvalid('bad-phone', 'Please enter a phone or WhatsApp number we can reach you on.', 'il-phone');
        return;
      }
      if (!data.get('consent')) {
        reportInvalid('no-consent', 'Please tick the box so we know we may reply to you.', 'il-consent');
        return;
      }
      errorEl?.classList.add('hidden');

      const payload = {
        phone,
        contact: phone,
        market: data.get('market'),
        context: form.dataset.context || '',
        source: window.location.href,
        page: window.location.pathname,
        collection,
        slug,
        formLocation: 'inline',
        formElapsedMs: Date.now() - renderedAt,
      };

      track('form_submit_attempt', {
        form_id: form.id,
        form_location: 'inline',
        market: String(payload.market || 'not_set'),
        page_path: window.location.pathname,
        collection,
        slug,
      });

      try {
        const res = await fetch('/api/lead/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('fail');
        document.getElementById('il-success')?.classList.remove('hidden');
        track('generate_lead', {
          form_id: form.id,
          form_location: 'inline',
          lead_type: 'inline_cta',
          market: String(payload.market || 'not_set'),
          page_path: window.location.pathname,
          collection,
          slug,
          value: 1,
          currency: 'USD',
        });
        setTimeout(() => window.location.assign('/thanks/?lead=1'), 400);
      } catch {
        if (errorEl) {
          errorEl.textContent = 'Something went wrong. Please try the full form at the end of this page.';
          errorEl.classList.remove('hidden');
        }
        track('form_submit_error', {
          form_id: form.id,
          form_location: 'inline',
          page_path: window.location.pathname,
          collection,
          slug,
        });
      }
    });
  }
</script>
