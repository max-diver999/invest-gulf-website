---
import { SITE } from '../data/site';

interface Props {
  title?: string;
  subtitle?: string;
  context?: string;
}

const {
  title = 'Get your Gulf property shortlist',
  subtitle = 'Share your budget and target market. We respond within one business day.',
  context = '',
} = Astro.props;

const waText = encodeURIComponent(
  'Hi, I need help with a Gulf property enquiry from Invest Gulf.',
);
const waHref = `${SITE.whatsapp}?text=${waText}`;
---
<section class="surface-card p-8 md:p-10" id="lead-form">
  <span class="badge-pill mb-3">Free · Independent advisory</span>
  <h2 class="text-2xl mb-1 text-[var(--color-ink)]">{title}</h2>
  <p class="text-[var(--color-muted)] mb-5 text-sm">{subtitle}</p>

  <form class="grid gap-4 ig-lead-form" id="ig-lead-form" data-context={context} novalidate>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-medium mb-1" for="lf-name">Your name *</label>
        <input type="text" id="lf-name" name="name" required placeholder="John Smith" autocomplete="name" />
      </div>
      <div>
        <label class="block text-xs font-medium mb-1" for="lf-phone">WhatsApp / Phone *</label>
        <input type="tel" id="lf-phone" name="phone" required placeholder="+44 7700 900000" autocomplete="tel" />
      </div>
    </div>
    <div>
      <label class="block text-xs font-medium mb-1" for="lf-email">Email</label>
      <input type="email" id="lf-email" name="email" placeholder="john@example.com" autocomplete="email" />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-medium mb-1" for="lf-market">Target market</label>
        <select id="lf-market" name="market">
          <option value="">Select</option>
          <option value="dubai">Dubai</option>
          <option value="abu-dhabi">Abu Dhabi</option>
          <option value="rak">Ras Al Khaimah</option>
          <option value="qatar">Qatar</option>
          <option value="saudi">Saudi Arabia</option>
          <option value="oman">Oman / Bahrain</option>
          <option value="multi">Multiple / not sure</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium mb-1" for="lf-budget">Budget (USD)</label>
        <select id="lf-budget" name="budget">
          <option value="">Select</option>
          <option value="under-300k">Under $300k</option>
          <option value="300-500k">$300k – $500k</option>
          <option value="500k-1m">$500k – $1M</option>
          <option value="1m-2m">$1M – $2M</option>
          <option value="2m+">$2M+ (Golden Visa range)</option>
        </select>
      </div>
    </div>
    <div>
      <label class="block text-xs font-medium mb-1" for="lf-goal">Your goal</label>
      <select id="lf-goal" name="goal">
        <option value="">Select</option>
        <option value="investment">Rental yield / investment</option>
        <option value="golden-visa">Golden Visa / residency</option>
        <option value="relocation">Relocation / end-use</option>
        <option value="off-plan">Off-plan / payment plan</option>
        <option value="explore">Just researching</option>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium mb-1" for="lf-message">Message (optional)</label>
      <textarea id="lf-message" name="message" rows="3" placeholder="E.g. 2BR off-plan, handover 2027, Business Bay or JVC…"></textarea>
    </div>
    <div class="lead-form-consent">
      <input type="checkbox" id="lf-consent" name="consent" required class="lead-form-consent__check" />
      <label class="lead-form-consent__label" for="lf-consent">I agree to be contacted about my enquiry. See our <a href="/privacy-policy/">Privacy Policy</a>.</label>
    </div>
    <p id="lf-error" class="hidden text-red-600 text-sm text-center" role="alert">
      Something went wrong. Email {SITE.email} or{' '}
      <a
        href={SITE.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-placement="inline_cta"
        data-cta="whatsapp_form_error"
      >
        WhatsApp us
      </a>.
    </p>
    <button type="submit" class="btn-primary w-full py-3">Request shortlist →</button>
    <p class="text-center text-sm text-[var(--color-muted)]">
      Prefer WhatsApp?
      <a
        href={waHref}
        class="font-medium text-[#128C7E] hover:underline"
        target="_blank"
        rel="noopener noreferrer"
        data-wa-placement="inline_cta"
        data-cta="whatsapp_lead_form"
      >
        Message us on WhatsApp
      </a>
    </p>
    <p id="lf-success" class="hidden text-green-700 text-sm font-medium text-center">Thank you. Redirecting…</p>
  </form>
</section>

<script>
  import { track } from '../lib/track';

  /** `/guides/uae-employment-visa-process/` -> { collection: 'guides', slug: '…' } */
  function pageIdentity() {
    const parts = window.location.pathname.split('/').filter(Boolean);
    return {
      collection: parts.length > 1 ? parts[0] : 'root',
      slug: parts.length > 0 ? parts[parts.length - 1] : 'home',
    };
  }

  document.querySelectorAll('form.ig-lead-form').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    const renderedAt = Date.now();
    let started = false;

    // A real field, not any focusin: the form contains the privacy policy link
    // and a WhatsApp link, and tabbing to either would count as starting it.
    form.querySelectorAll('input:not([tabindex="-1"]), select, textarea').forEach((field) => {
      field.addEventListener(
        'focus',
        () => {
          if (started) return;
          started = true;
          const { collection, slug } = pageIdentity();
          track('form_start', {
            form_id: form.id,
            form_context: form.dataset.context || '',
            form_location: 'article',
            page_path: window.location.pathname,
            collection,
            slug,
          });
        },
        { once: true },
      );
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const phone = String(data.get('phone') || '').trim();
      const email = String(data.get('email') || '').trim();
      const { collection, slug } = pageIdentity();

      // Every rejected submit reports, so the gap between form_start and
      // form_submit_attempt can be read instead of guessed at.
      function reportInvalid(reason: string, message: string, focusId: string) {
        const err = document.getElementById('lf-error');
        if (err) {
          err.textContent = message;
          err.classList.remove('hidden');
        }
        (document.getElementById(focusId) as HTMLElement | null)?.focus();
        track('form_validation_error', {
          form_id: form.id,
          form_location: 'article',
          reason,
          page_path: window.location.pathname,
          collection,
          slug,
        });
      }

      if (phone.replace(/\D/g, '').length < 8) {
        reportInvalid('bad-phone', 'Please enter a valid phone or WhatsApp number.', 'lf-phone');
        return;
      }
      // `novalidate` turns off the browser check, so the required consent box was
      // never enforced by anything.
      if (!data.get('consent')) {
        reportInvalid('no-consent', 'Please tick the box so we know we may reply to you.', 'lf-consent');
        return;
      }
      document.getElementById('lf-error')?.classList.add('hidden');

      const payload = {
        name: data.get('name'),
        phone,
        email,
        contact: email ? `${phone} / ${email}` : phone,
        budget: data.get('budget'),
        goal: data.get('goal'),
        message: data.get('message'),
        context: form.dataset.context || '',
        market: data.get('market'),
        source: window.location.href,
        page: window.location.pathname,
        collection,
        slug,
        formElapsedMs: Date.now() - renderedAt,
      };

      track('form_submit_attempt', {
        form_id: form.id,
        form_location: 'article',
        budget: String(payload.budget || 'not_set'),
        market: String(payload.market || 'not_set'),
        page_path: window.location.pathname,
        collection,
        slug,
      });

      try {
        const res = await fetch('/api/lead/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('fail');
        document.getElementById('lf-success')?.classList.remove('hidden');
        track('generate_lead', {
          form_id: form.id,
          form_location: 'article',
          lead_type: 'article_form',
          budget: String(payload.budget || 'not_set'),
          market: String(payload.market || 'not_set'),
          page_path: window.location.pathname,
          collection,
          slug,
          value: 1,
          currency: 'USD',
        });
        setTimeout(() => {
          window.location.assign('/thanks/?lead=1');
        }, 400);
      } catch {
        document.getElementById('lf-error')?.classList.remove('hidden');
        track('form_submit_error', {
          form_id: form.id,
          form_location: 'article',
          page_path: window.location.pathname,
          collection,
          slug,
        });
      }
    });
  });
</script>
