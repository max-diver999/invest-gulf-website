---
/**
 * Currency toggle control. Renders the button only; the conversion engine
 * lives in CurrencyEngine.astro and is mounted once by BaseLayout, so this can
 * appear in both the desktop header and the mobile drawer without duplicating
 * the logic.
 */
interface Props {
  variant?: 'header' | 'drawer';
}
const { variant = 'header' } = Astro.props;
---
<button
  type="button"
  class={`ig-fx-toggle ig-fx-toggle--${variant}`}
  data-ig-fx-toggle
  aria-pressed="false"
  title="Show USD equivalents alongside Gulf currency figures"
>
  <span aria-hidden="true">$</span>
  <span class="ig-fx-toggle__label">Show USD</span>
</button>

<style>
  .ig-fx-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 36px;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface, #fff);
    color: var(--color-muted);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
  }

  .ig-fx-toggle[aria-pressed='true'] {
    background: var(--color-teal-light);
    border-color: var(--color-teal);
    color: var(--color-teal-dark, #235851);
  }

  .ig-fx-toggle--drawer {
    width: 100%;
    justify-content: center;
    min-height: 44px;
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
  }

  /* The desktop bar is tight at the breakpoint; the drawer carries the control
     below it. */
  @media (max-width: 900px) {
    .ig-fx-toggle--header {
      display: none;
    }
  }
</style>
