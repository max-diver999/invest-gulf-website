      data: { labels: ga4.map(function(m) { return m.month; }), datasets: [{ label: 'Sessions', data: ga4.map(function(m) { return m.sessions; }), backgroundColor: ['rgba(78,158,126,0.45)','rgba(78,158,126,0.55)','rgba(78,158,126,0.7)','rgba(78,158,126,0.85)'], borderColor: '#b45309', borderWidth: 1, borderRadius: 8 }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { grid: { color: '#f5f3ef' }, beginAtZero: true }, x: { grid: { display: false } } } }
    });

    var cc = document.getElementById('chartContent');
    if (cc) new Chart(cc, {
      type: 'doughnut',
      data: { labels: content.map(function(c) { return c.type; }), datasets: [{ data: content.map(function(c) { return c.count; }), backgroundColor: content.map(function(c) { return c.color; }), borderWidth: 2, borderColor: '#fff' }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right', labels: { boxWidth: 12, padding: 12 } } }, cutout: '58%' }
    });

    var cd = document.getElementById('chartDaily');
    if (cd) new Chart(cd, {
      type: 'line',
      data: {
        labels: daily.map(function(d) { return d.d; }),
        datasets: [
          { label: 'Impressions', data: daily.map(function(d) { return d.i; }), borderColor: '#93c5fd', backgroundColor: 'rgba(147,197,253,0.22)', fill: true, tension: 0.35, yAxisID: 'y' },
          { label: 'Clicks', data: daily.map(function(d) { return d.c; }), borderColor: '#b45309', borderWidth: 2.5, pointRadius: 4, tension: 0.35, yAxisID: 'y1' }
        ]
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } }, scales: { y: { position: 'left', grid: { color: '#f5f3ef' } }, y1: { position: 'right', grid: { display: false }, min: 0 } } }
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
  else run();
})();
</script>

</body>
</html>
