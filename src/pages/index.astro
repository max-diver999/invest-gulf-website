---
import BaseLayout from '../layouts/BaseLayout.astro';
import { responsiveImage } from '../lib/responsiveImage';
import LeadForm from '../components/LeadForm.astro';
import EntryPoints from '../components/EntryPoints.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';
import { STICKY_HOME } from '../data/sticky-cta';

const guides = (await getCollection('guides'))
  .filter((g) => !g.data.noindex)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const featuredSlugs = [
  'dubai-property-investment-guide',
  'can-foreigners-buy-property-uae',
  'uae-golden-visa-property',
];
const featured = guides.filter((g) => featuredSlugs.includes(g.id));

// Герой берёт настоящий рендер из корпуса проектов и туда же ведёт.
const gulfProjects = await getCollection('projects');
const heroProject = gulfProjects.find((p) => p.data.heroImage && !p.data.noindex);
const heroImg = heroProject ? responsiveImage(heroProject.data.heroImage, 'hero') : null;
---
<BaseLayout
  title="Invest Gulf: Independent UAE & Gulf Property Research"
  description={SITE.description}
  stickyCta={STICKY_HOME}
  preloadImage={heroImg ? { src: heroImg.src, srcset: heroImg.srcset, sizes: heroImg.sizes ?? '(max-width: 1023px) 100vw, 50vw' } : null}
>
  <section class="ig-hero">
    <div class="ig-hero__grid site-container">
      <div class="ig-hero__copy">
        <span class="ig-hero__eyebrow">Gulf property · Independent research</span>
        <h1 class="ig-hero__title">
          Understand Gulf property<br/>
          <span class="ig-hero__accent">before you buy.</span>
        </h1>
        <p class="ig-hero__lede">
          Dubai, Abu Dhabi and Ras Al Khaimah — DLD fees and service charges, net yields after
          management, Golden Visa thresholds, and off-plan escrow checks before you reserve.
        </p>
        <div class="ig-hero__chips">
          <span class="ig-hero__chip">0% income tax on rental</span>
          <span class="ig-hero__chip">RERA-regulated referrals</span>
        </div>
        <div class="ig-hero__cta">
          <a href="/get-shortlist/" class="ig-hero__btn">Request a shortlist</a>
          <a href="/methodology/" class="ig-hero__link">How we verify &rarr;</a>
        </div>
      </div>

      {heroProject && heroImg && (
        <a href={`/projects/${heroProject.id}/`} class="ig-hero__media" aria-label={heroProject.data.title}>
          <img
            src={heroImg.src}
            srcset={heroImg.srcset}
            sizes={heroImg.sizes ?? '(max-width: 1023px) 100vw, 50vw'}
            alt={heroProject.data.title}
            width={heroImg.width}
            height={heroImg.height}
            loading="eager"
            fetchpriority="high"
          />
          <span class="ig-hero__scrim" aria-hidden="true"></span>
          <span class="ig-hero__caption">{heroProject.data.title.replace(/\s*[:\u2013-]\s.*$/, '')}</span>
        </a>
      )}
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <div class="flex items-end justify-between gap-4 mb-10">
        <div>
          <h2 class="text-2xl mb-2">Start here</h2>
          <p class="text-[var(--color-muted)]">High-intent guides for foreign buyers and yield-focused investors.</p>
        </div>
        <a href="/guides/" class="link-arrow shrink-0 hidden sm:inline">All guides →</a>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {(featured.length ? featured : guides).map((guide) => (
          <a href={`/guides/${guide.id}/`} class="surface-card is-link p-7 no-underline block">
            <span class="badge-pill mb-3">Guide</span>
            <h3 class="text-lg mb-2 text-[var(--color-ink)] font-semibold">{guide.data.title}</h3>
            <p class="text-sm text-[var(--color-muted)]">{guide.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <EntryPoints heading="Find your starting point" />
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <h2 class="text-2xl mb-10">Popular topics</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="surface-card p-7">
          <h3 class="text-base font-semibold mb-2">Compare markets</h3>
          <p class="text-sm text-[var(--color-muted)] mb-4">Dubai vs Abu Dhabi yields, fees, and buyer profiles side by side.</p>
          <a href="/compare/abu-dhabi-vs-dubai-investment/" class="link-arrow">Abu Dhabi vs Dubai →</a>
        </div>
        <div class="surface-card p-7">
          <h3 class="text-base font-semibold mb-2">Golden Visa</h3>
          <p class="text-sm text-[var(--color-muted)] mb-4">Property thresholds, timelines, and what actually qualifies in 2026.</p>
          <a href="/guides/uae-golden-visa-property/" class="link-arrow">Visa guide →</a>
        </div>
        <div class="surface-card p-7">
          <h3 class="text-base font-semibold mb-2">Foreign ownership</h3>
          <p class="text-sm text-[var(--color-muted)] mb-4">Freehold zones, escrow rules, and due diligence checklist.</p>
          <a href="/guides/can-foreigners-buy-property-uae/" class="link-arrow">Ownership rules →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <div class="prose max-w-3xl">
        <h2>What Invest Gulf is, and what it is not</h2>
        <p>
          Invest Gulf is an independent research publication covering property investment across the UAE and the wider Gulf. We are not a developer, not a licensed broker and not a listing portal. Nothing on this site is paid placement, and no developer buys a position in a guide or a shortlist.
        </p>
        <p>
          That independence is the whole point. Almost every page ranking for Gulf property terms belongs to a business that earns a commission when you transact, which makes some subjects effectively unpublishable for them: what a project actually costs to exit, which developers miss handover dates, when a service charge quietly removes two points of yield, and when the honest answer is that a budget does not yet buy anything worth owning. Those are the subjects we cover most closely.
        </p>

        <h2>How we work</h2>
        <p>
          Every figure we publish is meant to be traceable to a registry, a regulator or a document you could pull yourself. Rents come from registered contracts, Ejari in Dubai and Tawtheeq in Abu Dhabi, rather than from portal asking prices that typically run 10% to 15% higher. Service charges come from building-level records rather than community averages. Yields are quoted net of charges, management and a realistic vacancy allowance, and against total acquisition cost rather than headline price.
        </p>
        <p>
          Where a rule is in flux, we date the claim and name the instrument. Where we cannot verify something, we say so rather than rounding it into confidence. The full method sits on our <a href="/methodology/">methodology page</a>.
        </p>

        <h2>Where to start</h2>
        <ul>
          <li><strong>Buying for the first time:</strong> <a href="/guides/can-foreigners-buy-property-uae/">can foreigners buy property in the UAE</a>, then <a href="/guides/cost-of-buying-property-dubai/">what a purchase actually costs</a>.</li>
          <li><strong>Buying for income:</strong> the <a href="/guides/dubai-rental-yield-guide/">Dubai rental yield guide</a> and the <a href="/gcc-rental-yields/">GCC yields hub</a> for cross-market comparison.</li>
          <li><strong>Buying for residency:</strong> <a href="/golden-visa-dubai-property/">Golden Visa through Dubai property</a> and <a href="/guides/gulf-residency-by-investment-guide/">Gulf residency by investment</a>.</li>
          <li><strong>Buying off-plan:</strong> <a href="/guides/off-plan-property-dubai-guide/">the off-plan buyer's guide</a> and <a href="/guides/off-plan-risks-delays-dubai/">what delays actually cost you</a>.</li>
        </ul>
        <p>
          If you would rather skip the reading, the form below returns a shortlist matched to your budget, horizon and objective, with the reasoning attached.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <LeadForm context="Homepage" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Первый экран: графитовая ночь, латунь, много воздуха */
  .ig-hero { background: var(--color-frame); border-bottom: 1px solid var(--color-frame-line); }
  .ig-hero__grid { display: grid; gap: 2.75rem; padding-top: 4rem; padding-bottom: 4rem; align-items: center; }
  .ig-hero__eyebrow {
    display: inline-block; margin-bottom: 1.5rem;
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.3em;
    text-transform: uppercase; color: var(--color-brass);
  }
  .ig-hero__title {
    margin: 0 0 1.35rem;
    font-size: clamp(2.5rem, 5.6vw, 3.9rem);
    font-weight: 300; line-height: 1.08; letter-spacing: 0.005em;
    color: #f7f2e8;
  }
  .ig-hero__accent { color: var(--color-brass); font-style: italic; font-weight: 400; }
  .ig-hero__lede {
    margin: 0 0 1.9rem; max-width: 33rem;
    font-size: 1rem; line-height: 1.75; color: var(--color-frame-muted);
  }
  .ig-hero__chips { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2.1rem; }
  .ig-hero__chip {
    padding: 0.5rem 1.05rem; border: 1px solid rgba(194, 160, 106, 0.32); border-radius: 2px;
    font-size: 0.78rem; font-weight: 500; letter-spacing: 0.04em; color: var(--color-frame-text);
  }
  .ig-hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }
  .ig-hero__btn {
    display: inline-block; padding: 0.9rem 1.9rem; border-radius: 2px;
    background: var(--color-brass); color: #141a23;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    text-decoration: none; transition: background 0.25s ease;
  }
  .ig-hero__btn:hover { background: var(--color-brass-soft); }
  .ig-hero__link {
    font-size: 0.85rem; font-weight: 500; letter-spacing: 0.03em;
    color: var(--color-frame-text); text-decoration: none;
    border-bottom: 1px solid rgba(244, 239, 230, 0.35); padding-bottom: 3px;
  }
  .ig-hero__link:hover { color: var(--color-brass); border-color: var(--color-brass); }
  .ig-hero__media {
    position: relative; display: block; overflow: hidden; border-radius: 2px; text-decoration: none;
    box-shadow: 0 0 0 1px rgba(194, 160, 106, 0.35), 0 26px 70px rgba(6, 10, 16, 0.6);
  }
  .ig-hero__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ig-hero__scrim {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(19, 26, 36, 0.85) 0%, rgba(19, 26, 36, 0.05) 55%);
  }
  .ig-hero__caption {
    position: absolute; left: 1.5rem; right: 1.5rem; bottom: 1.2rem;
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.2em;
    text-transform: uppercase; color: #f4efe6;
  }
  @media (min-width: 1024px) {
    .ig-hero__grid {
      grid-template-columns: 1fr 1fr; gap: 4rem;
      padding-top: 5rem; padding-bottom: 5rem; min-height: min(74svh, 680px);
    }
    .ig-hero__media { height: 100%; min-height: 27rem; }
  }
  @media (max-width: 1023px) { .ig-hero__media { aspect-ratio: 16 / 10; } }
</style>
