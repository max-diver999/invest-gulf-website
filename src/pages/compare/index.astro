---
import { responsiveImage } from '../../lib/responsiveImage';
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const comparisons = (await getCollection('compare'))
  .filter((c) => !c.data.noindex)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout
  title="Gulf Property Market Comparisons"
  description="Side-by-side comparisons of Dubai, Abu Dhabi, and other Gulf markets for property investors."
>
  <section class="site-container py-14 md:py-20">
    <header class="max-w-2xl mb-12">
      <h1 class="text-3xl">Market comparisons</h1>
      <p class="text-lg text-[var(--color-muted)] mt-3">
        When two markets look similar on a brochure, these breakdowns show fees, yields, and buyer fit.
      </p>
    </header>
    <div class="grid md:grid-cols-2 gap-6">
      {comparisons.map((item) => (
        <article class="ig-card">
          {item.data.heroImage && (
            <a href={`/compare/${item.id}/`} class="ig-card__media" tabindex="-1" aria-hidden="true">
              <img
                src={responsiveImage(item.data.heroImage, 'card').src}
                srcset={responsiveImage(item.data.heroImage, 'card').srcset}
                sizes={responsiveImage(item.data.heroImage, 'card').sizes}
                alt=""
                width={responsiveImage(item.data.heroImage, 'card').width}
                height={responsiveImage(item.data.heroImage, 'card').height}
                loading="lazy"
                decoding="async"
              />
            </a>
          )}
          <div class="ig-card__body">
            <h2 class="ig-card__title">
              <a href={`/compare/${item.id}/`} class="no-underline">{item.data.title}</a>
            </h2>
            <p class="ig-card__desc">{item.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
