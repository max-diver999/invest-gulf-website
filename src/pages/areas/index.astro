---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const areas = (await getCollection('areas'))
  .filter((a) => !a.data.noindex)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const dubai = areas.filter((a) => /dubai|jvc|jlt|marina|palm|damac|arabian|mbr|business-bay|sports-city|islands|creek|hills|south/i.test(a.id));
const other = areas.filter((a) => !dubai.includes(a));
---
<BaseLayout
  title="Gulf Property Investment by Area"
  description="Area guides for Dubai, Abu Dhabi, RAK, Qatar, and Saudi — yields, entry prices, and buyer fit by district."
>
  <section class="site-container py-14 md:py-20">
    <header class="max-w-2xl mb-12">
      <h1 class="text-3xl">Investment areas</h1>
      <p class="text-lg text-[var(--color-muted)] mt-3">
        District-level guides for foreign buyers. Compare yields, ticket sizes, and liquidity before you shortlist projects.
      </p>
      <p class="mt-4 text-sm">
        <a href="/guides/dubai-property-investment-guide/" class="text-[var(--color-teal)]">Dubai investment hub</a>
        · <a href="/guides/abu-dhabi-property-investment-guide/" class="text-[var(--color-teal)]">Abu Dhabi hub</a>
        · <a href="/compare/" class="text-[var(--color-teal)]">Market comparisons</a>
      </p>
    </header>

    {dubai.length > 0 && (
      <section class="mb-14">
        <h2 class="text-xl mb-5">Dubai &amp; UAE emirates</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {dubai.map((area) => (
            <article class="surface-card p-7">
              <h3 class="text-lg mb-2 font-semibold">
                <a href={`/areas/${area.id}/`} class="no-underline text-[var(--color-ink)] hover:text-[var(--color-teal)]">{area.data.title}</a>
              </h3>
              <p class="text-sm text-[var(--color-muted)]">{area.data.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {other.length > 0 && (
      <section>
        <h2 class="text-xl mb-5">Abu Dhabi, RAK, Qatar &amp; Saudi</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {other.map((area) => (
            <article class="surface-card p-7">
              <h3 class="text-lg mb-2 font-semibold">
                <a href={`/areas/${area.id}/`} class="no-underline text-[var(--color-ink)] hover:text-[var(--color-teal)]">{area.data.title}</a>
              </h3>
              <p class="text-sm text-[var(--color-muted)]">{area.data.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}
  </section>
</BaseLayout>
