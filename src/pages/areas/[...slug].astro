---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { SITE } from '../../data/site';

export const prerender = true;

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  // A district that has moved into the geo tree renders at its own path and is
  // 301'd from here, so building it twice would put the same content on two URLs.
  return areas
    .filter((entry) => !entry.data.path)
    .map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const hasInlineFaqBlock = entry.body?.includes('<FaqBlock') ?? false;

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  readingTime,
  heroImage,
  faq,
  noindex,
  leadPlacement,
} = entry.data;
---
<ArticleLayout
  {title}
  {description}
  {pubDate}
  {updatedDate}
  {author}
  readingTime={readingTime ?? 8}
  {heroImage}
  {faq}
  {noindex}
  {leadPlacement}
  {hasInlineFaqBlock}
  contextLabel={title}
  articleSlug={entry.id}
  articleCollection="areas"
  canonical={`${SITE.url}/areas/${entry.id}/`}
>
  <Content />
</ArticleLayout>
