---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { SITE } from '../../data/site';

export const prerender = true;

export async function getStaticPaths() {
  const items = await getCollection('projects');
  return items.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const hasInlineFaqBlock = entry.body?.includes('<FaqBlock') ?? false;

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  readingTime,
  heroImage,
  heroAlt,
  faq,
  noindex,
  relatedSlugs,
  leadPlacement,
  priceFromAED,
} = entry.data;

// Цена проекта в машиночитаемом виде. Карточка описывает застройку из многих лотов и
// несёт цену «от», поэтому AggregateOffer с lowPrice, а не Offer с точной ценой.
// Наличие ставим только там, где статус однозначен, иначе поле не выводим.
const _status = String((entry.data as Record<string, unknown>).status ?? '').toLowerCase();
const _availability = /resale|on-market|completed|ready/.test(_status)
  ? 'https://schema.org/InStock'
  : /off-plan|under-construction|delivering|approved|restoration|pre-launch/.test(_status)
    ? 'https://schema.org/PreOrder'
    : null;
const priceSchema = typeof priceFromAED === 'number' && priceFromAED > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: (entry.data as Record<string, unknown>).projectName ?? title,
      description,
      ...(heroImage ? { image: heroImage } : {}),
      url: `${SITE.url}/projects/${entry.id}/`,
      offers: {
        '@type': 'AggregateOffer',
        lowPrice: priceFromAED,
        priceCurrency: 'AED',
        ...(_availability ? { availability: _availability } : {}),
        url: `${SITE.url}/projects/${entry.id}/`,
        seller: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      },
    }
  : null;
---
<ArticleLayout
  extraSchema={priceSchema}
  {title}
  {description}
  {pubDate}
  {updatedDate}
  {author}
  readingTime={readingTime ?? 10}
  {heroImage}
  {heroAlt}
  {faq}
  {noindex}
  {leadPlacement}
  {hasInlineFaqBlock}
  contextLabel={title}
  articleSlug={entry.id}
  {relatedSlugs}
  articleCollection="projects"
  canonical={`${SITE.url}/projects/${entry.id}/`}
>
  <Content />
</ArticleLayout>
