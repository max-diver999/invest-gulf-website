---
import { responsiveImage } from '../../lib/responsiveImage';
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.noindex)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout
  title="Gulf Off-Plan & New Project Reviews"
  description="Independent reviews of Dubai, Abu Dhabi, and Gulf off-plan projects, pricing, payment plans, developer track record, and investment case."
>
  <section class="site-container py-14 md:py-20">
    <header class="max-w-2xl mb-12">
      <h1 class="text-3xl">Project reviews</h1>
      <p class="text-lg text-[var(--color-muted)] mt-3">
        Due-diligence style reviews for major Gulf launches. Not sales brochures, verify pricing and handover dates before you commit.
      </p>
    </header>
    <div class="grid md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <article class="ig-card">
          {project.data.heroImage && (
            <a href={`/projects/${project.id}/`} class="ig-card__media" tabindex="-1" aria-hidden="true">
              <img
                src={responsiveImage(project.data.heroImage, 'card').src}
                srcset={responsiveImage(project.data.heroImage, 'card').srcset}
                sizes={responsiveImage(project.data.heroImage, 'card').sizes}
                alt=""
                width={responsiveImage(project.data.heroImage, 'card').width}
                height={responsiveImage(project.data.heroImage, 'card').height}
                loading="lazy"
                decoding="async"
              />
            </a>
          )}
          <div class="ig-card__body">
            <p class="ig-card__meta">{[project.data.developer, project.data.market].filter(Boolean).join(' · ')}</p>
            <h2 class="ig-card__title">
              <a href={`/projects/${project.id}/`} class="no-underline">{project.data.title}</a>
            </h2>
            <p class="ig-card__desc">{project.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
