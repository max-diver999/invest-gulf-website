---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SITE } from '../../data/site';
import { STICKY_CONTACT } from '../../data/sticky-cta';
---
<BaseLayout
  title="Contact Invest Gulf"
  description={`Contact Invest Gulf at ${SITE.email} or request a free Gulf property shortlist.`}
  stickyCta={STICKY_CONTACT}
>
  <section class="site-container py-12 md:py-16 max-w-2xl">
    <h1 class="mb-4">Contact</h1>
    <p class="text-[var(--color-muted)] mb-8">
      Editorial questions: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      For property shortlists, use the form below or{' '}
      <a
        href={`${SITE.whatsapp}?text=${encodeURIComponent('Hi, I need help with a Gulf property enquiry from Invest Gulf.')}`}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-placement="footer_contact"
        data-cta="whatsapp_contact_page"
      >
        WhatsApp
      </a>.
      We usually reply within one business day.
    </p>

    <div class="prose mb-10">
      <h2>What we can help with</h2>
      <ul>
        <li>A shortlist of properties matched to a budget, horizon and objective, with net yield estimates rather than gross.</li>
        <li>A second opinion on a unit or project you are already considering, including the checks we would want answered before a deposit.</li>
        <li>Cross-market comparison where several Gulf markets are still in contention.</li>
        <li>Corrections. If a figure on this site is wrong, tell us and we will fix the page.</li>
      </ul>

      <h2>What we cannot do</h2>
      <p>
        Invest Gulf is an independent research publication. We are not a licensed broker, not a developer and not a law or tax firm, so we do not hold client funds, execute transactions, or give immigration, legal or tax advice. Where a purchase proceeds, enquiries are referred to RERA-licensed partners who handle the transaction and the KYC.
      </p>

      <h2>Response times</h2>
      <p>
        Shortlist requests are answered within one business day. Editorial and correction emails are usually answered within two. We work to UAE business hours, so requests sent on Friday evening are picked up on Monday.
      </p>

      <h2>Press and data use</h2>
      <p>
        Journalists and researchers are welcome to cite figures from this site with a link. Where a number matters to your story, email us first and we will point you at the primary source we used rather than let our page become the citation. Our method is set out on the <a href="/methodology/">methodology page</a>.
      </p>
    </div>

    <LeadForm context="Contact page" />
  </section>
</BaseLayout>
