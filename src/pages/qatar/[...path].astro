---
import PlacePage from '../../components/PlacePage.astro';
import { getPlacesUnder } from '../../lib/places';

export const prerender = true;

export async function getStaticPaths() {
  const places = await getPlacesUnder('qatar');
  return places.map((place) => ({
    params: { path: place.rest },
    props: { place, siblings: places },
  }));
}

const { place, siblings } = Astro.props;
---
<PlacePage {place} {siblings} />
