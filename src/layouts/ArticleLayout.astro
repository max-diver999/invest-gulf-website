---
import BaseLayout from './BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import FaqBlock from '../components/FaqBlock.astro';
import GulfMoneyHubStrip from '../components/GulfMoneyHubStrip.astro';
import { SITE } from '../data/site';
import { responsiveImage, lcpPreloadFromResponsive } from '../lib/responsiveImage';
import { resolveStickyCta } from '../../scripts/lib/invest-gulf-cta-router.mjs';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  readingTime?: number;
  heroImage?: string;
  faq?: { question: string; answer: string }[];
  canonical?: string;
  noindex?: boolean;
  hasInlineFaqBlock?: boolean;
  contextLabel?: string;
  articleSlug?: string;
  articleCollection?: string;
  leadPlacement?: 'early' | 'end';
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = SITE.editorial,
  readingTime = 8,
  heroImage: heroImageProp,
  faq = [],
  canonical,
  noindex = false,
  hasInlineFaqBlock = false,
  contextLabel = title,
  articleSlug = '',
  articleCollection = 'guides',
  leadPlacement = 'end',
} = Astro.props;

const stickyCta = articleSlug
  ? resolveStickyCta({ collection: articleCollection, slug: articleSlug, title })
  : null;

const heroImage = heroImageProp || `${SITE.url}/apple-touch-icon.png`;
const hero = responsiveImage(heroImage, 'hero');

const dateStr = (updatedDate || pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const pageUrl = canonical || Astro.url.href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` },
  },
  mainEntityOfPage: pageUrl,
  ...(heroImage ? { image: heroImage } : {}),
};

const COLLECTION_LABELS: Record<string, string> = {
  guides: 'Guides',
  areas: 'Areas',
  compare: 'Compare',
  projects: 'Projects',
  news: 'News',
};
const collectionLabel = COLLECTION_LABELS[articleCollection] ?? 'Guides';
const collectionHref = `${SITE.url}/${articleCollection}/`;

const breadcrumbTrail = [
  { name: 'Home', url: `${SITE.url}/` },
  { name: collectionLabel, url: collectionHref },
  { name: title, url: pageUrl },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbTrail.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.name,
    item: crumb.url,
  })),
};

const heroAlt = `${title} — Invest Gulf research illustration`;
---
<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage={heroImage}
  type="article"
  {noindex}
  schema={[articleSchema, breadcrumbSchema]}
  stickyCta={stickyCta}
  preloadImage={heroImageProp ? lcpPreloadFromResponsive(heroImageProp, 'hero') : null}
>
  <div class="ig-band">
    <div class="site-container ig-band__inner">
    <nav aria-label="Breadcrumb" class="ig-band__crumbs max-w-3xl mb-4 text-sm">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/${articleCollection}/`}>{collectionLabel}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    <header class="max-w-3xl">
      <span class="badge-pill mb-4">Research guide</span>
      <h1 class="ig-band__h1 mb-4 max-w-3xl">{title}</h1>
      <p class="ig-band__lede text-lg mb-4 max-w-3xl">{description}</p>
      <p class="ig-band__meta text-sm">
        By {author} · Updated {dateStr} · {readingTime} min read
      </p>
    </header>
    </div>
  </div>

  <article class="site-container py-10 md:py-14">

    {heroImage && (
      <img
        src={hero.src}
        srcset={hero.srcset}
        sizes={hero.sizes}
        alt={heroAlt}
        width={hero.width}
        height={hero.height}
        class="w-full max-h-[420px] object-cover rounded-2xl mb-10 border border-[var(--color-border)]"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )}

    {leadPlacement === 'early' && (
      <div class="max-w-3xl mx-auto mb-10">
        <LeadForm
          title="Get a Gulf property shortlist"
          subtitle="Tell us your budget and target market. Independent research first; enquiries are matched with licensed local partners. We reply within one business day."
          context={contextLabel}
        />
      </div>
    )}

    <div class="prose mx-auto">
      <slot />
    </div>

    {!hasInlineFaqBlock && faq.length > 0 && (
      <div class="max-w-3xl mx-auto mt-10">
        <FaqBlock items={faq} />
      </div>
    )}

    <GulfMoneyHubStrip />

    {leadPlacement === 'end' && (
      <div class="max-w-3xl mx-auto mt-8">
        <LeadForm
          title="Get a Gulf property shortlist"
          subtitle="Tell us your budget and target market. Independent research first; enquiries are matched with licensed local partners. We reply within one business day."
          context={contextLabel}
        />
      </div>
    )}

    <aside class="max-w-3xl mx-auto mt-10 surface-card p-5 text-sm text-[var(--color-muted)]">
      <strong>Disclaimer:</strong> Invest Gulf is an independent editorial resource. We are not a developer or licensed broker.
      Enquiries may be referred to RERA-licensed partners. Prices, yields, and visa rules change, verify before any transaction.
    </aside>
  </article>
</BaseLayout>

<style is:global>
  /* Плашка заголовка: графитовая ночь, латунный бейдж, тонкий сериф */
  .ig-band { background: var(--color-frame); }
  .ig-band__inner { padding-top: 2rem; padding-bottom: 2.6rem; }
  .ig-band__h1 { color: #f7f2e8; font-size: clamp(2.1rem, 4.4vw, 3rem); font-weight: 400; line-height: 1.14; }
  .ig-band__lede { color: var(--color-frame-muted); }
  .ig-band__meta { color: var(--color-frame-muted); opacity: 0.85; }
  .ig-band__crumbs, .ig-band__crumbs a { color: var(--color-frame-muted); }
  .ig-band__crumbs a:hover { color: var(--color-brass); }
  .ig-band .badge-pill {
    background: transparent;
    border: 1px solid rgba(194, 160, 106, 0.45);
    color: var(--color-brass);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.66rem;
  }
</style>
