---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import StickyMobileLeadBar from '../components/StickyMobileLeadBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CurrencyEngine from '../components/CurrencyEngine.astro';
import WhatsAppIntentTracker from '../components/WhatsAppIntentTracker.astro';
import { SITE } from '../data/site';

interface StickyCtaProps {
  title: string;
  subtitle: string;
  buttonText: string;
  buttonHref: string;
  ctaId?: string;
}

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: object | object[];
  stickyCta?: StickyCtaProps | null;
}

const {
  title,
  description = SITE.description,
  canonical = Astro.url.href,
  ogImage = `${SITE.url}/og-default.png?v=2`,
  type = 'website',
  noindex = false,
  schema,
  stickyCta = null,
} = Astro.props;

// Keep the rendered <title> inside the ~60ch SERP window. The brand suffix is
// only appended when it still fits; longer titles ship bare rather than truncated.
const BRAND_SUFFIX = ' | Invest Gulf';
const TITLE_LIMIT = 60;
const fullTitle =
  title.includes('Invest Gulf') || title.length + BRAND_SUFFIX.length > TITLE_LIMIT
    ? title
    : `${title}${BRAND_SUFFIX}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'NewsMediaOrganization'],
  name: SITE.name,
  alternateName: 'Invest Gulf — Gulf Property Research',
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  logo: `${SITE.url}/favicon.svg`,
  foundingDate: '2025',
  areaServed: ['AE', 'QA', 'SA', 'BH', 'OM', 'KW'],
  knowsAbout: [
    'UAE property investment',
    'Dubai real estate',
    'Golden Visa property UAE',
    'Gulf property yields',
    'Off-plan property Dubai',
    'Abu Dhabi real estate',
    'Qatar property investment',
    'Saudi Arabia real estate',
  ],
  founder: {
    '@type': 'Person',
    name: 'Maksim Shchegolev',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: SITE.email,
    availableLanguage: ['English'],
  },
  // Only external references belong here — a site linking to itself proves nothing.
  sameAs: [
    ...SITE.sameAs,
    ...(SITE.wikidataId ? [`https://www.wikidata.org/wiki/${SITE.wikidataId}`] : []),
  ],
};

// `schema` accepts a single JSON-LD object or an array of them.
const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchemas = [orgSchema, ...extraSchemas];
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex,follow" />
    : <meta name="robots" content="index,follow,max-image-preview:large" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={fullTitle} />
  <meta name="twitter:image" content={ogImage} />
  <meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png?v=3" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
  {allSchemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <GoogleAnalytics />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  {stickyCta && <StickyMobileLeadBar {...stickyCta} />}
  <WhatsAppFloat />
  <CurrencyEngine />
  <WhatsAppIntentTracker />
</body>
</html>
