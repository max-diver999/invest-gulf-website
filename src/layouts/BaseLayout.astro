---
import globalStyles from '../styles/global.css?url';
import cormorant500 from '@fontsource/cormorant/files/cormorant-latin-500-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import StickyMobileLeadBar from '../components/StickyMobileLeadBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CurrencyEngine from '../components/CurrencyEngine.astro';
import WhatsAppIntentTracker from '../components/WhatsAppIntentTracker.astro';
import { SITE } from '../data/site';

interface StickyCtaProps {
  title: string;
  subtitle: string;
  buttonText: string;
  buttonHref: string;
  ctaId?: string;
}

interface PreloadImageProps {
  src: string;
  srcset?: string;
  sizes?: string;
}

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: object | object[];
  stickyCta?: StickyCtaProps | null;
  preloadImage?: PreloadImageProps | null;
}

const {
  title,
  description = SITE.description,
  canonical = Astro.url.href,
  ogImage = `${SITE.url}/og-default.png?v=2`,
  type = 'website',
  noindex = false,
  schema,
  stickyCta = null,
  preloadImage = null,
} = Astro.props;

const BRAND_SUFFIX = ' | Invest Gulf';
const TITLE_LIMIT = 60;
const fullTitle =
  title.includes('Invest Gulf') || title.length + BRAND_SUFFIX.length > TITLE_LIMIT
    ? title
    : `${title}${BRAND_SUFFIX}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'NewsMediaOrganization'],
  name: SITE.name,
  alternateName: 'Invest Gulf — Gulf Property Research',
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  logo: `${SITE.url}/favicon.svg`,
  foundingDate: '2025',
  areaServed: ['AE', 'QA', 'SA', 'BH', 'OM', 'KW'],
  knowsAbout: [
    'UAE property investment',
    'Dubai real estate',
    'Golden Visa property UAE',
    'Gulf property yields',
    'Off-plan property Dubai',
    'Abu Dhabi real estate',
    'Qatar property investment',
    'Saudi Arabia real estate',
  ],
  founder: {
    '@type': 'Person',
    name: 'Maksim Shchegolev',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: SITE.email,
    availableLanguage: ['English'],
  },
  sameAs: [
    ...SITE.sameAs,
    ...(SITE.wikidataId ? [`https://www.wikidata.org/wiki/${SITE.wikidataId}`] : []),
  ],
};

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchemas = [orgSchema, ...extraSchemas];
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#131a24" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex,follow" />
    : <meta name="robots" content="index,follow,max-image-preview:large" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={fullTitle} />
  <meta name="twitter:image" content={ogImage} />
  <meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png?v=3" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preload" href={cormorant500} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
  <link rel="dns-prefetch" href="https://res.cloudinary.com" />

  {preloadImage && (
    <link
      rel="preload"
      as="image"
      href={preloadImage.src}
      fetchpriority="high"
      {...(preloadImage.srcset ? { imagesrcset: preloadImage.srcset, imagesizes: preloadImage.sizes } : {})}
    />
  )}

  <style is:inline>
    :root {
      --color-page: #faf7f1;
      --color-ink: #171d26;
      --color-muted: #6a6459;
      --color-teal: #265a60;
      --color-frame: #131a24;
      --color-frame-line: rgba(194, 160, 106, 0.28);
      --color-frame-text: #f4efe6;
      --color-frame-muted: #a9a496;
      --color-brass: #c2a06a;
      --font-serif: 'Cormorant', Georgia, serif;
      --font-sans: 'DM Sans', system-ui, sans-serif;
    }
    html { -webkit-font-smoothing: antialiased; }
    body {
      margin: 0;
      background: var(--color-page);
      color: var(--color-muted);
      font-family: var(--font-sans);
      line-height: 1.65;
      font-size: 1rem;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }
    body > main { flex: 1 0 auto; }
    header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--color-frame);
      border-bottom: 1px solid var(--color-frame-line);
    }
    .ig-wordmark { font-family: var(--font-serif); color: var(--color-frame-text); }
    .ig-hero { background: var(--color-frame); color: var(--color-frame-text); }
    .ig-hero__title {
      font-family: var(--font-serif);
      color: var(--color-frame-text);
      line-height: 1.1;
    }
    .ig-hero__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .ig-hero__btn {
      display: inline-block;
      background: var(--color-brass);
      color: var(--color-frame);
      font-weight: 600;
      text-decoration: none;
      border-radius: 999px;
    }
  </style>
  <link rel="stylesheet" href={globalStyles} />

  {allSchemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  {stickyCta && <StickyMobileLeadBar {...stickyCta} />}
  <WhatsAppFloat />
  <CurrencyEngine />
  <WhatsAppIntentTracker />
  <GoogleAnalytics />
</body>
</html>
