{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/guides/uae-golden-visa-property-2026/",
      "destination": "/guides/uae-golden-visa-property/",
      "permanent": true
    },
    {
      "source": "/guides/uae-golden-visa-property-2026",
      "destination": "/guides/uae-golden-visa-property/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.invest-gulf.com" }],
      "destination": "https://invest-gulf.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
